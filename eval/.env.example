# OpenAI-compatible endpoint of your LiteLLM gateway.
# Include /v1 when your gateway only exposes versioned routes.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-your-litellm-key

# Model ids exactly as your gateway exposes them.
EXTRACTOR_MODEL=anthropic/claude-sonnet-4-5
JUDGE_MODEL=openai/gpt-5-mini

# Optional judge settings. Leave temperature unset for models that reject it.
# JUDGE_TEMPERATURE=0
